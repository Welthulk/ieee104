diff --git a/src/session/path_selector.cpp b/src/session/path_selector.cpp
new file mode 100644
index 0000000..f21cb41
--- /dev/null
+++ b/src/session/path_selector.cpp
@@ -0,0 +1,305 @@
+/*
+ * SPDX-FileCopyrightText: 2026 SOPTIM AG
+ * SPDX-License-Identifier: LicenseRef-Proprietary
+ * Author: Udo Schmitz (SOPTIM AG)
+ * All rights reserved by SOPTIM AG.
+ */
+/**
+ * @file path_selector.cpp
+ * @brief Implementation of path_selector.hpp.
+ */
+#include "session/path_selector.hpp"
+
+#include "codec/asdu_header.hpp"
+#include "codec/type_table.hpp"
+
+#include <algorithm>
+#include <array>
+#include <iterator>
+
+namespace iec104::session {
+namespace {
+
+constexpr std::uint8_t kEndOfInit = 70; // M_EI_NA_1
+
+std::uint64_t point_key(std::uint16_t station, std::uint32_t ioa) {
+    return (static_cast<std::uint64_t>(station) << 24U) | ioa;
+}
+
+PathTime distance(PathTime a, PathTime b) {
+    return a > b ? a - b : b - a;
+}
+
+std::size_t time_tag_length(codec::TimeTag tag) {
+    switch (tag) {
+    case codec::TimeTag::Cp56:
+        return 7U;
+    case codec::TimeTag::Cp24:
+        return 3U;
+    case codec::TimeTag::None:
+        break;
+    }
+    return 0U;
+}
+
+} // namespace
+
+PathSelector::PathSelector(std::size_t count, const PathSettings& settings,
+                           const codec::AsduProfile& profile)
+    : settings_(settings), profile_(profile), paths_(count) {}
+
+bool PathSelector::is_started(std::size_t p) const noexcept {
+    return p < paths_.size() && paths_[p].started;
+}
+
+const PathCounters& PathSelector::counters(std::size_t p) const noexcept {
+    static const PathCounters kNone{};
+    return p < paths_.size() ? paths_[p].counters : kNone;
+}
+
+std::size_t PathSelector::buffered(std::size_t p) const noexcept {
+    return p < paths_.size() ? paths_[p].buffer.size() : 0U;
+}
+
+bool PathSelector::encode(const codec::AsduHeader& header, const codec::InformationObject& object,
+                          Entry& out) const {
+    const codec::TypeInfo* type = codec::find_type(header.type_id);
+    if (type == nullptr || type->direction != codec::Direction::Monitor) {
+        return false;
+    }
+    codec::AsduHeader h = header;
+    h.sequence = false;
+    h.num_objects = 1;
+    std::array<std::uint8_t, codec::kMaxAsduLength> buf{};
+    std::size_t n = 0;
+    if (codec::encode_asdu(h, &object, 1, profile_, buf.data(), buf.size(), n) != IEC104_OK) {
+        return false;
+    }
+    const std::size_t begin = codec::header_length(profile_) + profile_.ioa_length;
+    const std::size_t tag = time_tag_length(type->time_tag);
+    if (n < begin + tag) {
+        return false;
+    }
+    out.asdu.assign(buf.begin(), buf.begin() + static_cast<std::ptrdiff_t>(n));
+    // Only the element octets are compared: the time tag is left out, and the
+    // type is not compared (both paths send the same type for a point).
+    out.value.assign(buf.begin() + static_cast<std::ptrdiff_t>(begin),
+                     buf.begin() + static_cast<std::ptrdiff_t>(n - tag));
+    out.key = point_key(header.common_address, object.ioa);
+    return true;
+}
+
+bool PathSelector::delivered_since(const Entry& e) const {
+    // The leading path delivered this point later, or the same value at about the same time.
+    const auto d = delivered_.find(e.key);
+    if (d == delivered_.end()) {
+        return false;
+    }
+    return d->second.time >= e.time ||
+           (d->second.value == e.value && d->second.time + settings_.replay_tolerance_ms >= e.time);
+}
+
+void PathSelector::prune(Path& path, PathTime now) const {
+    while (!path.buffer.empty() && (path.buffer.size() > settings_.replay_max_objects ||
+                                    now - path.buffer.front().time > settings_.replay_window_ms)) {
+        if (!delivered_since(path.buffer.front())) {
+            ++path.dropped_since_switch; // a replay would have needed it
+            ++path.counters.dropped;
+        }
+        path.buffer.pop_front();
+    }
+}
+
+void PathSelector::tick(PathTime now) {
+    for (Path& path : paths_) {
+        prune(path, now);
+    }
+    // A delivery older than every buffered object plus the tolerance decides
+    // nothing any more (replay_start() then replays all of the point, as for
+    // a point never delivered): forget it, so that the map stays small.
+    const PathTime keep = settings_.replay_window_ms + settings_.replay_tolerance_ms;
+    for (auto it = delivered_.begin(); it != delivered_.end();) {
+        it = now > it->second.time && now - it->second.time > keep ? delivered_.erase(it)
+                                                                   : std::next(it);
+    }
+}
+
+bool PathSelector::received(std::size_t p, const codec::AsduHeader& header,
+                            const codec::InformationObject& object, PathTime now) {
+    if (p >= paths_.size() || !paths_[p].started) {
+        return false;
+    }
+    Entry e;
+    const bool encoded = encode(header, object, e);
+    if (p == leading_) {
+        if (encoded) {
+            delivered_[e.key] = Delivered{now, std::move(e.value)};
+        }
+        return true;
+    }
+    // The end of initialization (70) belongs to the station that sent it, not to
+    // the process: a following path does not keep it for a replay.
+    if (encoded && header.type_id != kEndOfInit) {
+        e.time = now;
+        Path& path = paths_[p];
+        path.buffer.push_back(std::move(e));
+        ++path.counters.followed;
+        prune(path, now);
+    }
+    return false;
+}
+
+void PathSelector::started(std::size_t p, PathTime now, std::vector<PathAction>& out) {
+    if (p >= paths_.size() || paths_[p].started) {
+        return;
+    }
+    Path& path = paths_[p];
+    path.started = true;
+    path.buffer.clear();
+    path.dropped_since_switch = 0;
+    if (leading_ == kNoPath) {
+        make_leading(p, kNoPath,
+                     ever_led_ ? "path " + std::to_string(p + 1) + " started, no path was leading"
+                               : "first started path",
+                     now, out);
+    } else if (settings_.prefer_first_path && p == 0U && leading_ != 0U) {
+        make_leading(p, leading_, "preferred path 1 is back", now, out);
+    }
+}
+
+void PathSelector::lost(std::size_t p, const std::string& reason, PathTime now,
+                        std::vector<PathAction>& out) {
+    if (p >= paths_.size() || !paths_[p].started) {
+        return;
+    }
+    Path& path = paths_[p];
+    path.started = false;
+    path.buffer.clear();
+    if (p != leading_) {
+        return;
+    }
+    // The next started path in order after the lost one.
+    std::size_t next = kNoPath;
+    for (std::size_t i = 1; i < paths_.size(); ++i) {
+        const std::size_t c = (p + i) % paths_.size();
+        if (paths_[c].started) {
+            next = c;
+            break;
+        }
+    }
+    if (next == kNoPath) {
+        leading_ = kNoPath;
+        PathAction a;
+        a.kind = PathActionKind::AllLost;
+        a.path = p;
+        a.reason = "path " + std::to_string(p + 1) + " " + reason + ", no other path started";
+        out.push_back(std::move(a));
+        return;
+    }
+    make_leading(next, p, "path " + std::to_string(p + 1) + " " + reason, now, out);
+}
+
+void PathSelector::stop_all(const std::string& reason, std::vector<PathAction>& out) {
+    for (Path& path : paths_) {
+        path.started = false;
+        path.buffer.clear();
+        path.dropped_since_switch = 0;
+    }
+    if (leading_ != kNoPath) {
+        PathAction a;
+        a.kind = PathActionKind::AllLost;
+        a.path = leading_;
+        a.reason = reason;
+        out.push_back(std::move(a));
+        leading_ = kNoPath;
+    }
+}
+
+void PathSelector::make_leading(std::size_t p, std::size_t previous, const std::string& reason,
+                                PathTime now, std::vector<PathAction>& out) {
+    const bool first = !ever_led_;
+    leading_ = p;
+    ever_led_ = true;
+    Path& path = paths_[p];
+    ++path.counters.became_leading;
+    PathAction switched;
+    switched.kind = PathActionKind::Switched;
+    switched.path = p;
+    switched.previous = previous;
+    switched.reason = reason;
+    const std::size_t at = out.size();
+    out.push_back(PathAction{}); // placeholder: the switch is reported before the replay
+    replay(p, now, switched, out);
+    out[at] = std::move(switched);
+    if (!first && settings_.interrogation_after_switch) {
+        PathAction gi;
+        gi.kind = PathActionKind::Interrogate;
+        gi.path = p;
+        out.push_back(std::move(gi));
+    }
+}
+
+std::size_t PathSelector::replay_start(const std::deque<Entry>& buffer,
+                                       const std::vector<std::size_t>& positions,
+                                       std::uint64_t key) const {
+    const auto d = delivered_.find(key);
+    if (d == delivered_.end()) {
+        return 0; // never delivered: all of it
+    }
+    // Counterpart: the earliest object with the same value received within the
+    // tolerance. If the value recurs (a, b, a) inside the tolerance, the first a
+    // is taken: b and the second a are replayed. Doubles are allowed, losses not.
+    const PathTime tol = settings_.replay_tolerance_ms;
+    for (const std::size_t i : positions) {
+        const Entry& e = buffer[i];
+        if (e.value == d->second.value && distance(e.time, d->second.time) <= tol) {
+            return i + 1;
+        }
+    }
+    // No counterpart: everything from (last delivery - tolerance) on.
+    const PathTime from = d->second.time > tol ? d->second.time - tol : 0;
+    for (const std::size_t i : positions) {
+        if (buffer[i].time >= from) {
+            return i;
+        }
+    }
+    return buffer.size();
+}
+
+void PathSelector::replay(std::size_t p, PathTime now, PathAction& switched,
+                          std::vector<PathAction>& out) {
+    Path& path = paths_[p];
+    prune(path, now);
+    switched.dropped = path.dropped_since_switch;
+    path.dropped_since_switch = 0;
+    // Buffer positions per point, in order of arrival (one pass, so a switch-over
+    // stays linear in the buffer size).
+    std::map<std::uint64_t, std::vector<std::size_t>> at;
+    for (std::size_t i = 0; i < path.buffer.size(); ++i) {
+        at[path.buffer[i].key].push_back(i);
+    }
+    // Per point: buffer position from which on it is replayed.
+    std::map<std::uint64_t, std::size_t> first;
+    for (const auto& [key, positions] : at) {
+        first[key] = replay_start(path.buffer, positions, key);
+    }
+    for (std::size_t i = 0; i < path.buffer.size(); ++i) {
+        Entry& e = path.buffer[i];
+        if (i < first[e.key]) {
+            ++switched.suppressed;
+            continue;
+        }
+        delivered_[e.key] = Delivered{e.time, e.value};
+        PathAction a;
+        a.kind = PathActionKind::Deliver;
+        a.path = p;
+        a.asdu = std::move(e.asdu);
+        out.push_back(std::move(a));
+        ++switched.replayed;
+    }
+    path.counters.replayed += switched.replayed;
+    path.counters.suppressed += switched.suppressed;
+    path.buffer.clear();
+}
+
+} // namespace iec104::session
diff --git a/src/session/path_selector.hpp b/src/session/path_selector.hpp
new file mode 100644
index 0000000..2d83b7c
--- /dev/null
+++ b/src/session/path_selector.hpp
@@ -0,0 +1,180 @@
+/*
+ * SPDX-FileCopyrightText: 2026 SOPTIM AG
+ * SPDX-License-Identifier: LicenseRef-Proprietary
+ * Author: Udo Schmitz (SOPTIM AG)
+ * All rights reserved by SOPTIM AG.
+ */
+/**
+ * @file path_selector.hpp
+ * @brief Path redundancy of a controlling station: which path is leading, replay at switch-over.
+ *
+ * A controlling station keeps two or more paths (connections) to stations
+ * that carry the same process (docs/05_Normfragen_und_Festlegungen.md, E11).
+ * All paths are started; only the leading path is delivered to the
+ * application. The others follow: what they receive in monitor direction is
+ * kept for a time window.
+ *
+ *   started(p)   the path reached "started"; the first one becomes leading
+ *   lost(p)      the path left "started" (closed, t1, STOPDT, TLS ...); if it
+ *                was leading, another started path takes over
+ *   received()   one monitor-direction object of a path; true = deliver now
+ *
+ * Switch-over: a silent failure is detected late (t1, or t3 + t1). Objects
+ * the new leading path received in that time are delivered afterwards
+ * (replay). For every point the object last delivered is looked up in the
+ * buffer of the new path (same value and quality, time tag ignored, received
+ * within the tolerance; the earliest such object); everything after it is
+ * replayed in the order of arrival. Without such a counterpart everything from (time of the last
+ * delivery - tolerance) is replayed; for a point never delivered, all of it.
+ * Afterwards a general interrogation on the new path aligns what the replay
+ * cannot (Interrogate action). Duplicates are possible around the failure,
+ * losses are not, as long as the window covers the detection time.
+ *
+ * Layer: session (no I/O, no clock: times come from the caller).
+ */
+#pragma once
+
+#include "codec/asdu.hpp"
+
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace iec104::session {
+
+/** @brief Times are milliseconds of a monotonic clock. */
+using PathTime = std::uint64_t;
+
+/** @brief Settings of the selector (see iec104_path_options). */
+struct PathSettings {
+    PathTime replay_window_ms{50000};      ///< Objects of following paths kept this long.
+    std::size_t replay_max_objects{10000}; ///< At most this many per path; older ones are dropped.
+    PathTime replay_tolerance_ms{500};     ///< Arrival times of both paths may differ this much.
+    bool interrogation_after_switch{true}; ///< Interrogate action after a switch-over.
+    bool prefer_first_path{false};         ///< Path 0 takes over again when it is back.
+};
+
+/** @brief What the caller has to do. */
+enum class PathActionKind : std::uint8_t {
+    Deliver,     ///< Hand @ref PathAction::asdu (one object) to the application.
+    Switched,    ///< @ref PathAction::path is leading now (previous: @ref PathAction::previous).
+    Interrogate, ///< Send a general interrogation on @ref PathAction::path.
+    AllLost,     ///< No path is started any more.
+};
+
+/** @brief One instruction of the selector. */
+struct PathAction {
+    PathActionKind kind{PathActionKind::Deliver};
+    std::size_t path{0};            ///< Path the action belongs to.
+    std::size_t previous{0};        ///< Switched: former leading path, kNoPath if none.
+    std::vector<std::uint8_t> asdu; ///< Deliver: ASDU with exactly this object.
+    std::string reason;             ///< Switched, AllLost: why.
+    std::size_t replayed{0};        ///< Switched: objects delivered from the buffer.
+    std::size_t suppressed{0};      ///< Switched: buffered objects not delivered (already known).
+    std::size_t dropped{0};         ///< Switched: objects lost from the buffer (see PathCounters).
+};
+
+/** @brief Counters of one path. */
+struct PathCounters {
+    std::uint64_t became_leading{0}; ///< Times this path became leading.
+    std::uint64_t replayed{0};       ///< Objects replayed from its buffer.
+    std::uint64_t suppressed{0};     ///< Buffered objects not replayed.
+    /// Objects that fell out of its buffer (window or size) although the leading path
+    /// had not delivered that point since: a switch-over then would have missed them.
+    /// Objects the leading path delivered as well are not counted.
+    std::uint64_t dropped{0};
+    std::uint64_t followed{0}; ///< Objects received while following.
+};
+
+/** @brief Selector of the leading path, with replay buffer. */
+class PathSelector {
+  public:
+    /** @brief "No path". */
+    static constexpr std::size_t kNoPath = static_cast<std::size_t>(-1);
+
+    /**
+     * @param count    Number of paths, 1..4.
+     * @param settings See PathSettings.
+     * @param profile  ASDU profile used to encode buffered objects.
+     */
+    PathSelector(std::size_t count, const PathSettings& settings,
+                 const codec::AsduProfile& profile);
+
+    /** @brief Path @p p reached "started". */
+    void started(std::size_t p, PathTime now, std::vector<PathAction>& out);
+
+    /** @brief Path @p p left "started"; @p reason in words for the log. */
+    void lost(std::size_t p, const std::string& reason, PathTime now, std::vector<PathAction>& out);
+
+    /**
+     * @brief One monitor-direction object received on path @p p.
+     * @return true if @p p is leading: deliver the received ASDU as it is.
+     */
+    bool received(std::size_t p, const codec::AsduHeader& header,
+                  const codec::InformationObject& object, PathTime now);
+
+    /**
+     * @brief Every path stops at once (the application stops or closes): no
+     *        switch-over, no replay; AllLost with @p reason if a path was leading.
+     */
+    void stop_all(const std::string& reason, std::vector<PathAction>& out);
+
+    /** @brief Drops buffered objects older than the window. */
+    void tick(PathTime now);
+
+    /** @brief The leading path, kNoPath if none. */
+    [[nodiscard]] std::size_t leading() const noexcept { return leading_; }
+
+    /** @brief true if path @p p is started. */
+    [[nodiscard]] bool is_started(std::size_t p) const noexcept;
+
+    /** @brief Counters of path @p p. */
+    [[nodiscard]] const PathCounters& counters(std::size_t p) const noexcept;
+
+    /** @brief Objects currently buffered for path @p p. */
+    [[nodiscard]] std::size_t buffered(std::size_t p) const noexcept;
+
+    /** @brief Number of paths. */
+    [[nodiscard]] std::size_t count() const noexcept { return paths_.size(); }
+
+  private:
+    struct Entry {
+        PathTime time{0};
+        std::uint64_t key{0};            ///< Station and IOA.
+        std::vector<std::uint8_t> asdu;  ///< One object, ready to deliver.
+        std::vector<std::uint8_t> value; ///< Element octets without time tag.
+    };
+    struct Path {
+        bool started{false};
+        std::deque<Entry> buffer;
+        std::size_t dropped_since_switch{0};
+        PathCounters counters;
+    };
+    struct Delivered {
+        PathTime time{0};
+        std::vector<std::uint8_t> value;
+    };
+
+    bool encode(const codec::AsduHeader& header, const codec::InformationObject& object,
+                Entry& out) const;
+    void prune(Path& path, PathTime now) const;
+    [[nodiscard]] bool delivered_since(const Entry& e) const;
+    [[nodiscard]] std::size_t replay_start(const std::deque<Entry>& buffer,
+                                           const std::vector<std::size_t>& positions,
+                                           std::uint64_t key) const;
+    void make_leading(std::size_t p, std::size_t previous, const std::string& reason, PathTime now,
+                      std::vector<PathAction>& out);
+    void replay(std::size_t p, PathTime now, PathAction& switched, std::vector<PathAction>& out);
+
+    PathSettings settings_;
+    codec::AsduProfile profile_;
+    std::vector<Path> paths_;
+    std::size_t leading_{kNoPath};
+    bool ever_led_{false};
+    std::map<std::uint64_t, Delivered> delivered_; ///< Last object delivered per point.
+};
+
+} // namespace iec104::session
