+// IOA of a new station point: the next free one after the last created (from 100),
+// filled in automatically until the user types an own one.
+let pioaTouched = false, lastPointIoa = 0;
+function suggestIoa(points) {
+  const used = new Set(points.map(p => p.ioa));
+  let n = lastPointIoa ? lastPointIoa + 1 : 100;
+  while (used.has(n)) n++;
+  return n;
+}
