diff --git a/examples/hello_client.c b/examples/hello_client.c
new file mode 100644
index 0000000..93a3c8c
--- /dev/null
+++ b/examples/hello_client.c
@@ -0,0 +1,82 @@
+/*
+ * SPDX-FileCopyrightText: 2026 SOPTIM AG
+ * SPDX-License-Identifier: LicenseRef-Proprietary
+ * Author: Udo Schmitz (SOPTIM AG)
+ * All rights reserved by SOPTIM AG.
+ */
+/*
+ * hello_client: smallest useful IEC 104 client (controlling station).
+ *
+ * Connects, starts data transfer, sends a general interrogation to station 1,
+ * prints every received object, and ends when the interrogation is
+ * terminated and three spontaneous values have arrived.
+ *
+ *   hello_client [host] [port]     default 127.0.0.1 2404
+ *
+ * Exit code 0 = done, 1 = connection failed or closed.
+ */
+#include <iec104/iec104.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+static int interrogation_done = 0;
+static int spontaneous = 0;
+static iec104_link_state state = IEC104_LINK_CONNECTING;
+
+static void on_state(void* user, uint32_t connection, iec104_link_state s,
+                     iec104_close_reason reason) {
+    (void)user;
+    (void)connection;
+    state = s;
+    printf("state: %s", iec104_link_state_string(s));
+    if (s == IEC104_LINK_CLOSED) {
+        printf(" (%s)", iec104_close_reason_string(reason));
+    }
+    printf("\n");
+}
+
+static void on_object(void* user, uint32_t connection, const iec104_asdu_info* info,
+                      const iec104_object* object) {
+    (void)user;
+    (void)connection;
+    printf("type %3u  cause %2u  station %u  IOA %u  value %g\n", info->type, info->cause,
+           info->common_address, object->ioa, object->value);
+    if (info->type == 100 && info->cause == IEC104_COT_ACTIVATION_TERMINATION) {
+        interrogation_done = 1;
+    }
+    if (info->cause == IEC104_COT_SPONTANEOUS) {
+        ++spontaneous;
+    }
+}
+
+int main(int argc, char** argv) {
+    const char* host = argc > 1 ? argv[1] : "127.0.0.1";
+    const uint16_t port = argc > 2 ? (uint16_t)atoi(argv[2]) : IEC104_DEFAULT_PORT;
+
+    iec104_callbacks callbacks = {0};
+    callbacks.on_state = on_state;
+    callbacks.on_object = on_object;
+
+    iec104_client* client = NULL;
+    if (iec104_client_create(NULL, &callbacks, &client) != IEC104_OK ||
+        iec104_client_connect(client, host, port) != IEC104_OK) {
+        return 1;
+    }
+
+    int started = 0;
+    int interrogated = 0;
+    while (state != IEC104_LINK_CLOSED && !(interrogation_done && spontaneous >= 3)) {
+        iec104_client_poll(client, 100);
+        if (state == IEC104_LINK_STOPPED && !started) {
+            iec104_client_start(client); /* STARTDT */
+            started = 1;
+        }
+        if (state == IEC104_LINK_STARTED && !interrogated) {
+            iec104_client_interrogation(client, 1, 20); /* station 1, QOI 20 = all points */
+            interrogated = 1;
+        }
+    }
+    const int ok = state != IEC104_LINK_CLOSED;
+    iec104_client_destroy(client);
+    return ok ? 0 : 1;
+}
diff --git a/examples/hello_server.c b/examples/hello_server.c
new file mode 100644
index 0000000..a9a9d31
--- /dev/null
+++ b/examples/hello_server.c
@@ -0,0 +1,83 @@
+/*
+ * SPDX-FileCopyrightText: 2026 SOPTIM AG
+ * SPDX-License-Identifier: LicenseRef-Proprietary
+ * Author: Udo Schmitz (SOPTIM AG)
+ * All rights reserved by SOPTIM AG.
+ */
+/*
+ * hello_server: smallest useful IEC 104 server (controlled station).
+ *
+ * One station (common address 1) with one measured value (IOA 100, short
+ * float). The value rises every second and is sent spontaneously; the
+ * library answers a general interrogation by itself. Commands are logged
+ * and accepted.
+ *
+ *   hello_server [port]       default port 2404, 0 = any free port
+ */
+#include <iec104/iec104.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+
+static volatile sig_atomic_t stop = 0;
+static void on_signal(int sig) {
+    (void)sig;
+    stop = 1;
+}
+
+static int on_command(void* user, uint32_t connection, const iec104_asdu_info* info,
+                      const iec104_object* command) {
+    (void)user;
+    printf("connection %u: command type %u, IOA %u, value %g\n", connection, info->type,
+           command->ioa, command->value);
+    return 1; /* accept */
+}
+
+static void on_log(void* user, iec104_log_level level, uint32_t connection, const char* message) {
+    (void)user;
+    printf("[%s] %u: %s\n", iec104_log_level_string(level), connection, message);
+}
+
+int main(int argc, char** argv) {
+    const uint16_t port = argc > 1 ? (uint16_t)atoi(argv[1]) : IEC104_DEFAULT_PORT;
+
+    iec104_callbacks callbacks = {0};
+    callbacks.on_command = on_command;
+
+    iec104_server* server = NULL;
+    if (iec104_server_create(NULL, &callbacks, &server) != IEC104_OK) { /* NULL = standard values */
+        return 1;
+    }
+    iec104_server_set_log(server, IEC104_LOG_INFO, on_log, NULL);
+
+    iec104_object value = {0};
+    value.type = 13; /* M_ME_NC_1: short floating point measured value */
+    value.ioa = 100;
+    value.value = 0.0;
+    iec104_server_add_point(server, 1, &value, 0x0001); /* station 1, interrogation group 1 */
+
+    iec104_status st = iec104_server_listen(server, NULL, port);
+    if (st != IEC104_OK) {
+        fprintf(stderr, "listen: %s\n", iec104_status_string(st));
+        iec104_server_destroy(server);
+        return 1;
+    }
+    printf("listening on port %u\n", iec104_server_port(server));
+    fflush(stdout);
+
+    signal(SIGINT, on_signal);
+    signal(SIGTERM, on_signal);
+    time_t last = time(NULL);
+    while (!stop) {
+        iec104_server_poll(server, 100); /* receive, timers, answers, callbacks */
+        if (time(NULL) != last) {        /* once per second: new value, sent spontaneously */
+            last = time(NULL);
+            value.value += 1.0;
+            iec104_server_update(server, 1, &value);
+        }
+        fflush(stdout);
+    }
+    iec104_server_destroy(server);
+    return 0;
+}
