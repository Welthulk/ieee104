+    iec104_group_config_init(&g);
+    EXPECT_EQ(iec104_server_add_group(server_, &g, nullptr), IEC104_ERR_WRONG_STATE);
+    iec104_group_stats s{};
+    EXPECT_EQ(iec104_server_get_group_stats(server_, 99, &s), IEC104_ERR_WRONG_STATE);
+}
